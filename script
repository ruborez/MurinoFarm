local farmThread = nil
local isSyncing = false

local function stopFarm() Settings.AutoFarm = false; if farmThread then pcall(function() task.cancel(farmThread) end); farmThread = nil end end
local function startFarm()
    stopFarm(); Settings.AutoFarm = true
    farmThread = task.spawn(function()
        while Settings.AutoFarm do
            task.wait(Settings.Delay)
            local h = getRoot()
            if h then
                local hPos = h.Position
                if not startPos then startPos, lastPos, currentProgress = hPos, hPos, 0 end
                local target = pickTarget(hPos)
                if target then
                    markPair(target); h.CFrame = CFrame.new(target.Position + Vector3.new(0, 3, 0))
                    lastPos = target.Position; local dist = (target.Position - startPos).Magnitude
                    if dist > currentProgress then currentProgress = dist end
                else lastPos = hPos end
            end
        end
    end)
end

