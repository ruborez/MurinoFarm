-- ============================ БАЗОВЫЕ ФУНКЦИИ ============================
local function getRoot() local char = p.Character; return char and char:FindFirstChild("HumanoidRootPart") end
local triggers, visited, order = {}, {}, 0
local startPos, lastPos, currentProgress = nil, nil, 0

local function isTrigger(o) return o:IsA("BasePart") and o.Name == "Trigger" and o.Transparency >= 0.5 end
local function addTrigger(o) order += 1; table.insert(triggers, {part=o, order=order}) end

for _, o in ipairs(workspace:GetDescendants()) do if isTrigger(o) then addTrigger(o) end end
workspace.DescendantAdded:Connect(function(o) if isTrigger(o) then addTrigger(o) end end)

local dangerousParts = {}
task.spawn(function()
    while true do
        local newDangerous = {}
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and (v.Name:lower():find("ladder") or v.Name:lower():find("banana") or v.Name:lower():find("stair")) then
                table.insert(newDangerous, v)
            end
        end
        dangerousParts = newDangerous; task.wait(10)
    end
end)

local function isDangerous(pos)
    if not Settings.SkipLadder then return false end
    for _, v in ipairs(dangerousParts) do if (v.Position - pos).Magnitude < 10 then return true end end
    return false
end

local function pickTarget(hPos)
    local best, bestScore = nil, math.huge; local dir = Vector3.zero
    if startPos then dir = (hPos - startPos); if dir.Magnitude < 0.1 then dir = Vector3.new(1,0,0) end; dir = dir.Unit end
    for _, t in ipairs(triggers) do
        local o = t.part
        if o and o.Parent and not visited[o] then
            local po = o.Position
            if isDangerous(po) then visited[o] = true; continue end
            if Settings.Mode == "Newest" then
                local score = -t.order; if score < bestScore then bestScore, best = score, o end
            elseif Settings.Mode == "Progress" then
                local fromStart = (po - startPos).Magnitude
                if fromStart > currentProgress + 2 then
                    local d = (po - hPos).Magnitude; local score = d - fromStart*0.5
                    if score < bestScore then bestScore, best = score, o end
                end
            elseif Settings.Mode == "Direction" then
                local ddir = dir; if lastPos and (hPos-lastPos).Magnitude > 0.5 then ddir = (hPos-lastPos).Unit end
                local proj = (po - hPos):Dot(ddir)
                if proj > 1 then local d = (po - hPos).Magnitude; local score = d - proj*0.5; if score < bestScore then bestScore, best = score, o end end
            else local d = (po - hPos).Magnitude; if d < bestScore then bestScore, best = d, o end end
        end
    end
    return best
end

local function markPair(target)
    visited[target] = true; local tp = target.Position
    for _, t in ipairs(triggers) do local o = t.part; if o and o.Parent and (o.Position - tp).Magnitude <= 10 then visited[o] = true end end
end

