-- ============================ ESP СИСТЕМА ============================
local espObjects = {}
local lastEspUpdate = 0

local function clearESP()
    for _, obj in ipairs(espObjects) do if obj.highlight then obj.highlight:Destroy() end end
    espObjects = {}
end

local function updateESP()
    if tick() - lastEspUpdate < 1 then return end
    lastEspUpdate = tick(); clearESP()
    if not p.Character then return end

    if Settings.ESPPlayers then
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= p and other.Character then
                local h = Instance.new("Highlight", other.Character)
                h.FillColor = Color3.fromRGB(255, 0, 0); h.FillTransparency = 0.5; h.OutlineColor = Color3.fromRGB(255, 0, 0)
                table.insert(espObjects, {highlight = h})
            end
        end
    end

    if Settings.ESPMonsters then
        local playerCharacters = {}
        for _, plr in ipairs(Players:GetPlayers()) do if plr.Character then playerCharacters[plr.Character] = true end end
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Model") and not playerCharacters[v] and v:FindFirstChild("Humanoid") then
                local h = Instance.new("Highlight", v)
                h.FillColor = Color3.fromRGB(255, 255, 0); h.FillTransparency = 0.5; h.OutlineColor = Color3.fromRGB(255, 255, 0)
                table.insert(espObjects, {highlight = h})
            end
        end
    end

    if Settings.ESPItems then
        for _, v in ipairs(workspace:GetDescendants()) do
            if (v:IsA("Model") or v:IsA("BasePart")) and not v:FindFirstChildOfClass("Highlight") then
                local isItem = v:FindFirstChildOfClass("ProximityPrompt") ~= nil
                local n = v.Name:lower()
                if n:find("key") or n:find("med") or n:find("item") or n:find("tool") or n:find("ключ") or n:find("аптеч") or n:find("лут") then isItem = true end
                if isItem then
                    local h = Instance.new("Highlight", v)
                    h.FillColor = Color3.fromRGB(0, 255, 255); h.OutlineColor = Color3.fromRGB(255, 255, 255)
                    table.insert(espObjects, {highlight = h})
                end
            end
        end
    end

    if Settings.ESPHideouts then
        for _, v in ipairs(workspace:GetDescendants()) do
            if (v:IsA("Model") or v:IsA("BasePart")) and not v:FindFirstChildOfClass("Highlight") then
                local n = v.Name:lower()
                if n:find("closet") or n:find("locker") or n:find("hide") or n:find("door") or n:find("шкаф") or n:find("дверь") or v:FindFirstChildOfClass("ProximityPrompt") then
                    local h = Instance.new("Highlight", v)
                    h.FillColor = Color3.fromRGB(0, 255, 0); h.OutlineColor = Color3.fromRGB(255, 255, 255)
                    table.insert(espObjects, {highlight = h})
                end
            end
        end
    end
end

