-- ============================ УМНЫЙ AUTO-IQ (ИСПРАВЛЕН) ============================
local autoIQThread = nil
local lastSolvedEquation = ""

local function stopAutoIQ() Settings.AutoIQ = false; if autoIQThread then pcall(function() task.cancel(autoIQThread) end); autoIQThread = nil end end
local function startAutoIQ()
    stopAutoIQ()
    Settings.AutoIQ = true
    autoIQThread = task.spawn(function()
        while Settings.AutoIQ do
            task.wait(1)
            local guis = {p:FindFirstChild("PlayerGui"), game:GetService("CoreGui")}
            local equation = nil
            local activeGui = nil
            
            -- Ищем текст с примером, ИГНОРИРУЯ Rayfield
            for _, gui in ipairs(guis) do
                if gui then
                    for _, obj in ipairs(gui:GetDescendants()) do
                        if obj:IsA("TextLabel") and obj.Text ~= "" then
                            -- Проверка: не является ли это меню Rayfield
                            local isRayfield = false
                            local parent = obj
                            while parent do
                                if parent.Name == "Rayfield" or parent.Name:lower():find("rayfield") then
                                    isRayfield = true
                                    break
                                end
                                parent = parent.Parent
                            end
                            
                            if not isRayfield then
                                local txt = obj.Text
                                -- Строгий поиск математики (число + знак + число)
                                if txt:match("%d+%s*[%+%-%*xх/]%s*%d+") then
                                    equation = txt; activeGui = gui; break
                                end
                            end
                        end
                    end
                end
                if equation then break end
            end

            if equation and equation ~= lastSolvedEquation then
                lastSolvedEquation = equation
                print("[SWILL IQ] Найден пример: " .. equation)
                task.wait(1)

                -- Считаем
                local cleanEq = equation:lower():gsub("%s+", ""):gsub("x", "*"):gsub("х", "*"):gsub("=", ""):gsub("%?", "")
                local success, result = pcall(function() return loadstring("return " .. cleanEq)() end)
                
                if success and type(result) == "number" then
                    local answer = tostring(math.floor(result))
                    print("[SWILL IQ] Ответ: " .. answer)
                    
                    -- Ищем кнопку с ответом
                    local foundButton = false
                    for _, btn in ipairs(activeGui:GetDescendants()) do
                        if btn:IsA("TextButton") or btn:IsA("TextLabel") then
                            if btn.Text == answer or btn.Text == tostring(answer) .. " " then
                                local pos = Vector2.new(btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2, btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2)
                                VirtualUser:ClickButton1(pos)
                                foundButton = true
                                print("[SWILL IQ] Нажата кнопка с ответом: " .. answer)
                                break
                            end
                        end
                    end
                    if not foundButton then print("[SWILL IQ] Кнопка с ответом не найдена!") end
                end
            end
        end
    end)
end

