-- ============================ ТРИГГЕРЫ ДЛЯ АВТОФАРМА ============================
local triggers, visited, order = {}, {}, 0
local startPos, lastPos, currentProgress = nil, nil, 0

local function isTrigger(o)
    return o:IsA("BasePart") and o.Name == "Trigger" and o.Transparency >= 0.5
end

local function addTrigger(o)
    order += 1
    table.insert(triggers, {part=o, order=order})
end

for _, o in ipairs(workspace:GetDescendants()) do
    if isTrigger(o) then addTrigger(o) end
end

workspace.DescendantAdded:Connect(function(o)
    if isTrigger(o) then addTrigger(o) end
end)

-- ============================ ОБЩИЕ ФУНКЦИИ ============================
local function getRoot()
    local char = p.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function teleportTo(pos)
    local root = getRoot()
    if root then
        root.CFrame = CFrame.new(pos)
    end
end

-- ============================ АВТОФАРМ ============================
local function pickTarget(hPos)
    local best, bestScore = nil, math.huge
    local dir = Vector3.zero
    if startPos then
        dir = (hPos - startPos)
        if dir.Magnitude < 0.1 then dir = Vector3.new(1,0,0) end
        dir = dir.Unit
    end

    for _, t in ipairs(triggers) do
        local o = t.part
        if o and o.Parent and not visited[o] then
            local po = o.Position
            if Settings.Mode == "Newest" then
                local score = -t.order
                if score < bestScore then bestScore, best = score, o end
            elseif Settings.Mode == "Progress" then
                local fromStart = (po - startPos).Magnitude
                if fromStart > currentProgress + 2 then
                    local d = (po - hPos).Magnitude
                    local score = d - fromStart*0.5
                    if score < bestScore then bestScore, best = score, o end
                end
            elseif Settings.Mode == "Direction" then
                local ddir = dir
                if lastPos and (hPos-lastPos).Magnitude > 0.5 then ddir = (hPos-lastPos).Unit end
                local proj = (po - hPos):Dot(ddir)
                if proj > 1 then
                    local d = (po - hPos).Magnitude
                    local score = d - proj*0.5
                    if score < bestScore then bestScore, best = score, o end
                end
            else -- Nearest
                local d = (po - hPos).Magnitude
                if d < bestScore then bestScore, best = d, o end
            end
        end
    end
    return best
end

local function markPair(target)
    visited[target] = true
    local tp = target.Position
    for _, t in ipairs(triggers) do
        local o = t.part
        if o and o.Parent and (o.Position - tp).Magnitude <= 10 then visited[o] = true end
    end
end

local function farmLoop()
    while Settings.AutoFarm do
        task.wait(Settings.Delay)
        local h = getRoot()
        if h then
            local hPos = h.Position
            if not startPos then startPos, lastPos, currentProgress = hPos, hPos, 0 end
            local target = pickTarget(hPos)
            if target then
                markPair(target)
                h.CFrame = CFrame.new(target.Position)
                lastPos = target.Position
                local dist = (target.Position - startPos).Magnitude
                if dist > currentProgress then currentProgress = dist end
            else
                lastPos = hPos
            end
        end
    end
end

p.CharacterAdded:Connect(function()
    startPos, lastPos, currentProgress, visited = nil, nil, 0, {}
end)

-- ============================ ESP СИСТЕМА ============================
local espObjects = {} -- {highlight, part, type, model}
local lastEspUpdate = 0

local function clearESP()
    for _, obj in ipairs(espObjects) do
        if obj.highlight then obj.highlight:Destroy() end
        if obj.frame then obj.frame:Destroy() end
    end
    espObjects = {}
end

local function updateESP()
    -- Обновляем не чаще 1 раза в секунду, чтобы не лагать
    if tick() - lastEspUpdate < 1 then return end
    lastEspUpdate = tick()
    clearESP()

    local myChar = p.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    -- ESP игроков и маньяка
    if Settings.ESPPlayers or Settings.ESPManiac then
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= p and other.Character then
                local hr = other.Character:FindFirstChild("HumanoidRootPart")
                if hr then
                    local color = Color3.fromRGB(255, 0, 0) -- красный
                    if Settings.ESPManiac and (Settings.SelectedManiac == other or (Settings.ManiacName and other.Name:lower():find(Settings.ManiacName:lower()))) then
                        color = Color3.fromRGB(255, 0, 255) -- пурпурный
                    end
                    local h = Instance.new("Highlight")
                    h.FillColor = color
                    h.FillTransparency = 0.5
                    h.OutlineColor = color
                    h.OutlineTransparency = 0
                    h.Parent = other.Character
                    table.insert(espObjects, {highlight = h, part = hr, type = "player"})

                    local bill = Instance.new("BillboardGui")
                    bill.Size = UDim2.new(0, 80, 0, 20)
                    bill.Adornee = hr
                    bill.AlwaysOnTop = true
                    local label = Instance.new("TextLabel", bill)
                    label.Size = UDim2.new(1,0,1,0)
                    label.BackgroundTransparency = 1
                    label.TextColor3 = color
                    label.Font = Enum.Font.GothamBold
                    label.TextSize = 14
                    label.Text = string.format("%.0f m", (hr.Position - myRoot.Position).Magnitude)
                    bill.Parent = other.Character
                    table.insert(espObjects, {highlight = nil, frame = bill, part = hr, type = "player"})
                end
            end
        end
    end

    -- ESP монстров (все модели с Humanoid, кроме игроков)
    if Settings.ESPMonsters then
        local playerCharacters = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then playerCharacters[plr.Character] = true end
        end
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Model") and not playerCharacters[v] and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
                local hr = v:FindFirstChild("HumanoidRootPart")
                if hr then
                    local h = Instance.new("Highlight")
                    h.FillColor = Color3.fromRGB(255, 255, 0) -- жёлтый
                    h.FillTransparency = 0.5
                    h.OutlineColor = Color3.fromRGB(255, 255, 0)
                    h.OutlineTransparency = 0
                    h.Parent = v
                    table.insert(espObjects, {highlight = h, part = hr, type = "monster"})
                end
            end
        end
    end
end

-- ============================ FULLBRIGHT ============================
local lighting = game:GetService("Lighting")
local oldBrightness, oldAmbient, oldOutdoorAmbient, oldClockTime
local function applyFullBright()
    if Settings.FullBright then
        oldBrightness = lighting.Brightness
        oldAmbient = lighting.Ambient
        oldOutdoorAmbient = lighting.OutdoorAmbient
        oldClockTime = lighting.ClockTime
        lighting.Brightness = 1
        lighting.Ambient = Color3.new(1,1,1)
        lighting.OutdoorAmbient = Color3.new(1,1,1)
        lighting.ClockTime = 14
    else
        if oldBrightness then
            lighting.Brightness = oldBrightness
            lighting.Ambient = oldAmbient
            lighting.OutdoorAmbient = oldOutdoorAmbient
            lighting.ClockTime = oldClockTime
        end
    end
end

RunService.RenderStepped:Connect(function()
    if Settings.FullBright then applyFullBright() end
end)

-- ============================ АНТИ РАШ ============================
local function findClosestCloset()
    local myPos = getRoot() and getRoot().Position
    if not myPos then return nil end
    local closest, bestD = nil, math.huge
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and (v.Name:lower():find("closet") or v.Name:lower():find("шкаф") or v.Name:lower():find("shield")) then
            local dist = (v.Position - myPos).Magnitude
            if dist < bestD then
                bestD = dist
                closest = v
            end
        end
    end
    return closest
end

local function isRushActive()
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= p and other.Character then
            local hr = other.Character:FindFirstChild("HumanoidRootPart")
            local hum = other.Character:FindFirstChild("Humanoid")
            if hr and hum then
                if hum.MoveDirection.Magnitude > 0 and hr.Velocity.Magnitude > 50 then
                    return true
                end
            end
        end
    end
    return false
end

local function antiRushLoop()
    while Settings.AntiRush do
        task.wait(0.5)
        if isRushActive() then
            local closet = findClosestCloset()
            if closet then
                teleportTo(closet.Position + Vector3.new(0, 3, 0))
                task.wait(1)
            end
        end
    end
end

-- ============================ АВТО ПРИВЕТ АРТУРУ ============================
local function findArthur()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Model") and (v.Name:lower():find("arthur") or v.Name:lower():find("артур")) then
            return v
        end
    end
    return nil
end

local function autoArthurLoop()
    while Settings.AutoArthur do
        task.wait(5)
        local arthur = findArthur()
        if arthur then
            local hr = arthur:FindFirstChild("HumanoidRootPart") or arthur:FindFirstChild("Torso") or arthur:FindFirstChild("UpperTorso")
            if hr then
                local myRoot = getRoot()
                if myRoot then
                    local myPos = myRoot.Position
                    teleportTo(hr.Position + Vector3.new(0, 2, 0))
                    task.wait(1)
                    teleportTo(myPos)
                end
            end
        end
    end
end

