-- ============================ БАЗОВЫЕ ФУНКЦИИ ============================
local function getRoot()
    local char = p.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local triggers, visited, order = {}, {}, 0
local startPos, lastPos, currentProgress = nil, nil, 0

local function isTrigger(o)
    return o:IsA("BasePart") and o.Name == "Trigger" and o.Transparency >= 0.5
end

local function addTrigger(o)
    order += 1
    table.insert(triggers, {part=o, order=order})
end

for _, o in ipairs(workspace:GetDescendants()) do
    if isTrigger(o) then addTrigger(o) end
end

workspace.DescendantAdded:Connect(function(o)
    if isTrigger(o) then addTrigger(o) end
end)

-- Кэшируем опасные зоны, чтобы не лагало
local dangerousParts = {}
task.spawn(function()
    while true do
        local newDangerous = {}
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and (v.Name:lower():find("ladder") or v.Name:lower():find("banana") or v.Name:lower():find("stair")) then
                table.insert(newDangerous, v)
            end
        end
        dangerousParts = newDangerous
        task.wait(10)
    end
end)

local function isDangerous(pos)
    if not Settings.SkipLadder then return false end
    for _, v in ipairs(dangerousParts) do
        if (v.Position - pos).Magnitude < 10 then return true end
    end
    return false
end

local function pickTarget(hPos)
    local best, bestScore = nil, math.huge
    local dir = Vector3.zero
    if startPos then
        dir = (hPos - startPos)
        if dir.Magnitude < 0.1 then dir = Vector3.new(1,0,0) end
        dir = dir.Unit
    end

    for _, t in ipairs(triggers) do
        local o = t.part
        if o and o.Parent and not visited[o] then
            local po = o.Position
            if isDangerous(po) then
                visited[o] = true
                continue
            end
            if Settings.Mode == "Newest" then
                local score = -t.order
                if score < bestScore then bestScore, best = score, o end
            elseif Settings.Mode == "Progress" then
                local fromStart = (po - startPos).Magnitude
                if fromStart > currentProgress + 2 then
                    local d = (po - hPos).Magnitude
                    local score = d - fromStart*0.5
                    if score < bestScore then bestScore, best = score, o end
                end
            elseif Settings.Mode == "Direction" then
                local ddir = dir
                if lastPos and (hPos-lastPos).Magnitude > 0.5 then ddir = (hPos-lastPos).Unit end
                local proj = (po - hPos):Dot(ddir)
                if proj > 1 then
                    local d = (po - hPos).Magnitude
                    local score = d - proj*0.5
                    if score < bestScore then bestScore, best = score, o end
                end
            else
                local d = (po - hPos).Magnitude
                if d < bestScore then bestScore, best = d, o end
            end
        end
    end
    return best
end

local function markPair(target)
    visited[target] = true
    local tp = target.Position
    for _, t in ipairs(triggers) do
        local o = t.part
        if o and o.Parent and (o.Position - tp).Magnitude <= 10 then visited[o] = true end
    end
end

-- ============================ УПРАВЛЕНИЕ ПОТОКАМИ ============================
local farmThread, antiRushThread, autoArthurThread = nil, nil, nil
local isSyncing = false

local function stopFarm()
    Settings.AutoFarm = false
    if farmThread then 
        pcall(function() task.cancel(farmThread) end)
        farmThread = nil 
    end
end

local function startFarm()
    stopFarm()
    Settings.AutoFarm = true
    farmThread = task.spawn(function()
        while Settings.AutoFarm do
            task.wait(Settings.Delay)
            local h = getRoot()
            if h then
                local hPos = h.Position
                if not startPos then startPos, lastPos, currentProgress = hPos, hPos, 0 end
                local target = pickTarget(hPos)
                if target then
                    markPair(target)
                    -- Телепорт ровно на триггер
                    h.CFrame = CFrame.new(target.Position + Vector3.new(0, 3, 0))
                    lastPos = target.Position
                    local dist = (target.Position - startPos).Magnitude
                    if dist > currentProgress then currentProgress = dist end
                else
                    lastPos = hPos
                end
            end
        end
    end)
end

local function stopAntiRush()
    Settings.AntiRush = false
    if antiRushThread then pcall(function() task.cancel(antiRushThread) end); antiRushThread = nil end
end

local function startAntiRush()
    stopAntiRush()
    Settings.AntiRush = true
    antiRushThread = task.spawn(function()
        while Settings.AntiRush do
            task.wait(0.5)
            local function isRushActive()
                for _, other in ipairs(Players:GetPlayers()) do
                    if other ~= p and other.Character then
                        local hr = other.Character:FindFirstChild("HumanoidRootPart")
                        local hum = other.Character:FindFirstChild("Humanoid")
                        if hr and hum and hum.MoveDirection.Magnitude > 0 and hr.Velocity.Magnitude > 50 then return true end
                    end
                end
                return false
            end

            if isRushActive() then
                local myPos = getRoot() and getRoot().Position
                local closest, bestD = nil, math.huge
                if myPos then
                    for _, v in ipairs(workspace:GetDescendants()) do
                        if v:IsA("BasePart") and (v.Name:lower():find("closet") or v.Name:lower():find("шкаф") or v.Name:lower():find("shield")) then
                            local dist = (v.Position - myPos).Magnitude
                            if dist < bestD then bestD = dist; closest = v end
                        end
                    end
                end
                if closest then
                    local root = getRoot()
                    if root then root.CFrame = CFrame.new(closest.Position + Vector3.new(0, 3, 0)) end
                    task.wait(1)
                end
            end
        end
    end)
end

local function stopAutoArthur()
    Settings.AutoArthur = false
    if autoArthurThread then pcall(function() task.cancel(autoArthurThread) end); autoArthurThread = nil end
end

local function startAutoArthur()
    stopAutoArthur()
    Settings.AutoArthur = true
    autoArthurThread = task.spawn(function()
        while Settings.AutoArthur do
            task.wait(5)
            local arthur = nil
            local names = {"arthur", "артур", "npcharacter", "npc"}
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                    local name = v.Name:lower()
                    for _, n in ipairs(names) do
                        if name:find(n) and not Players:GetPlayerFromCharacter(v) then arthur = v break end
                    end
                end
                if arthur then break end
            end

            if arthur then
                local hr = arthur:FindFirstChild("HumanoidRootPart") or arthur:FindFirstChild("Torso") or arthur:FindFirstChild("UpperTorso")
                if hr then
                    local myRoot = getRoot()
                    if myRoot then
                        local myPos = myRoot.Position
                        myRoot.CFrame = CFrame.new(hr.Position + Vector3.new(0, 3, 0))
                        task.wait(1)
                        myRoot.CFrame = CFrame.new(myPos)
                    end
                end
            end
        end
    end)
end

